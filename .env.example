# Local development and testing only. Create your own copy with:
#   cp .env.example .env && chmod 600 .env
# Railway does not use this file: set Variables with the same names there.

# Bot token from @BotFather (digits:text).
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (ask @userinfobot).
OWNER_ID=

# false = preview only: replies are shown in the logs and never sent.
# true = replies are sent to people automatically.
AUTO_SEND=false

# Output of `claude setup-token` (sk-ant-oat...). Create it once on a computer with a
# browser; it is valid for 1 year. Keep it like a password. Paste it with a text editor,
# on a single line (do not use echo, it would stay in your shell history).
# If left empty, this machine's `claude` login is used (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = find it on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Model name or alias. Empty = the CLI default.
CLAUDE_MODEL=

# One of: low, medium, high, xhigh, max.
CLAUDE_EFFORT=low

# Kill the CLI if one reply takes longer than this.
CLAUDE_TIMEOUT_SECONDS=120

# How long to wait after a usage limit when Claude does not say when it resets.
LIMIT_COOLDOWN_MINUTES=30

# Stay silent in a chat for this long after you write there yourself. 0 = off.
OWNER_TAKEOVER_MINUTES=15

# Messages remembered per chat.
HISTORY_LIMIT=30
